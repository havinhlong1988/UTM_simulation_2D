# ======================================================================
# Corridor network builder parameters (07_build_corridor_network.py)
# ======================================================================
# Build the shared UAV corridor network: infrastructure only, no
# routing. All network nodes (DB/DK objectives + step 03 TN candidates)
# are simply connected to their neighbors -- TN-TN connections included.
# Straight lines first, Theta* any-angle turns only where an obstacle
# blocks the straight line. Every connection carries 2 parallel
# corridors of CORRIDOR_DIAMETER_M with centerlines kept at least
# MIN_CENTERLINE_SEPARATION_M apart. Path planning over the finished
# network happens later and is out of scope.

# Input/output
MODEL_FILE = "output/03_clustering_hitcount/master_plan_input_nodes.csv"
OUTPUT_DIR = "output/07_corridor_network_ringsep"

# ----------------------------------------------------------------------
# Network nodes
# ----------------------------------------------------------------------
NETWORK_OBJECTIVE_PREFIXES = ["DB", "DK"]
NETWORK_INCLUDE_MINOR_TN = True

# ----------------------------------------------------------------------
# Legs (straight first, Theta* only against obstacles)
# ----------------------------------------------------------------------
# MAXIMIZED connectivity: EVERY node pair within LEG_MAX_LENGTH_M whose
# straight line keeps LEG_CLEARANCE_M to all no-fly nodes becomes a
# connection (e.g. DK05-DK03 or MAJ001-DK01 directly, without an
# intermediate TN). Blocked pairs are kept only for the LEG_KNN_K
# nearest neighbors -- those get one Theta* any-angle detour; detours
# longer than LEG_MAX_DETOUR_RATIO x the straight distance are dropped.
LEG_KNN_K = 5
LEG_MAX_LENGTH_M = 2500.0
LEG_CLEARANCE_M = 50.0
LEG_MAX_DETOUR_RATIO = 2.0

# Corridors may only meet AT network nodes: connections that cross
# another connection in mid-air, or that fly straight over an
# intermediate node's circle without stopping there, are skipped
# (shorter connections win, so the dropped ones are the long redundant
# diagonals).
LEG_SKIP_CROSSING = True

# Local optimization of Theta* detour legs: greedy line-of-sight
# shortcutting replaces the raw grid staircase with straight segments
# wherever the straight segment keeps LEG_SMOOTH_CLEARANCE_M to every
# no-fly node, so the offset lanes come out straight too.
LEG_SMOOTH_ENABLE = True
LEG_SMOOTH_CLEARANCE_M = 50.0

# ----------------------------------------------------------------------
# Two parallel corridors per connection (dual-parallel soft buffer, 06)
# ----------------------------------------------------------------------
# Each corridor is CORRIDOR_DIAMETER_M wide (drawn as the transparent
# band with gray boundary). The two centerlines are kept at least
# MIN_CENTERLINE_SEPARATION_M apart, so with 50/50 the corridors are
# tangent and never overlap.
CORRIDOR_DIAMETER_M = 50.0
MIN_CENTERLINE_SEPARATION_M = 50.0
# Every network node is a CIRCLE of this diameter. The two lane
# centerlines of a leg are the parallel EXTERNAL TANGENTS of the end
# circles: symmetric +/- (diameter/2) offsets of the connection
# centerline that touch the outside of each circle -- no perpendicular
# connector stubs anywhere. Keep this equal to
# MIN_CENTERLINE_SEPARATION_M so the tangency is exact.
NODE_CIRCLE_DIAMETER_M = 50.0
# When one symmetric tangent offset side is blocked by an obstacle
# (e.g. DK02-DK05 threads a no-fly gap off-center), the whole lane pair
# is shifted sideways off the centerline -- separation preserved -- by
# the smallest shift (steps of LANE_SHIFT_STEP_M, up to
# LANE_SHIFT_MAX_M) that clears the obstacles on both sides.
LANE_SHIFT_MAX_M = 100.0
LANE_SHIFT_STEP_M = 5.0
# The end node circles MOVE WITH their shifted corridors: each shifted
# leg demands a lateral displacement at both end nodes, the node moves
# by the average demand (capped at NODE_SHIFT_MAX_M, skipped if the
# moved circle would touch a no-fly node) and the network is rebuilt
# from the moved nodes -- usually turning the shifted pairs back into
# symmetric tangent pairs. network_nodes.csv keeps x_orig/y_orig and
# node_shift_m.
NODE_SHIFT_ENABLE = True
NODE_SHIFT_MAX_M = 50.0
NODE_SHIFT_MAX_PASSES = 2

# ----------------------------------------------------------------------
# Backup TN suggestion (purple)
# ----------------------------------------------------------------------
# After the first network build, flyable spots inside the network's
# convex hull that are far from every node and corridor centerline
# (low-density areas) get a SUGGESTED backup TN (net_id BAKxx, drawn
# purple). They are connected like any other node on the rebuild and
# open extra legs that back up the network when a primary corridor is
# unavailable.
BACKUP_TN_ENABLE = True
BACKUP_TN_MAX = 6
BACKUP_TN_MIN_NETWORK_DIST_M = 400.0
BACKUP_TN_CLEARANCE_M = 100.0
BACKUP_TN_SPACING_M = 800.0

# ----------------------------------------------------------------------
# Expansion TN suggestion (magenta): use the space OUTSIDE the network
# ----------------------------------------------------------------------
# Farthest-point sampling over the flyable cells outside the network
# hull: suggested extension TNs (net_id EXTxx, drawn magenta) pull
# corridors into the unused space. Each pick must keep
# EXPANSION_TN_CLEARANCE_M to the no-fly fields and lie within
# EXPANSION_TN_MAX_LINK_M of a (possibly just suggested) node so a leg
# can reach it; sampling stops when every outside pocket is within
# EXPANSION_TN_MIN_DIST_M of the network. Suggestions that end up with
# no buildable connection are dropped again.
EXPANSION_TN_ENABLE = True
EXPANSION_TN_MAX = 8
EXPANSION_TN_MIN_DIST_M = 700.0
EXPANSION_TN_CLEARANCE_M = 100.0
EXPANSION_TN_MAX_LINK_M = 2000.0
# The dual-parallel soft-buffer search below is only the last-resort
# fallback when no clearing shift exists either.
PARALLEL_SOFT_BUFFER_ENABLE = True
BUFFER_TARGET_M = 50.0
BUFFER_SAMPLE_STEP_M = 10.0
BUFFER_PENALTY_LAMBDA_INIT = 1.0
BUFFER_PENALTY_GROWTH_RATE = 1.5
BUFFER_PENALTY_LAMBDA_CAP = 50.0
BUFFER_CROSSING_MULTIPLIER = 8.0
BUFFER_MAX_ITERATIONS = 20
BUFFER_FIELD_RADIUS_M = 75.0
BUFFER_CORRIDOR_MAX_OFFSET_M = 250.0
# Lane endpoints merge at the network node -- trim only a short driveway
# (legs are much shorter than 06's full pair routes).
ENDPOINT_BUFFER_M = 100.0

# ----------------------------------------------------------------------
# Theta* engine (used only for obstacle-blocked legs and lane 2)
# ----------------------------------------------------------------------
NOFLY_SLOWNESS_THRESHOLD = 10.0
NOFLY_SLOWNESS_VALUE = 10.0
SEARCH_BBOX_BUFFER_M = 1500.0
RETRY_FULL_MAP_IF_FAILED = True
# Network legs SHOULD pass near terminals/TNs -- disable the per-pair
# avoidance/attraction cost shaping from 06.
USE_OTHER_DB_DK_TRAFFIC_AVOIDANCE = False
USE_FLZ_SAFETY_ATTRACTION = False

# ----------------------------------------------------------------------
# Plotting
# ----------------------------------------------------------------------
PLOT_DPI = 250
# One map per objective pair showing the path from A to B through its
# intermediate legs (red/blue centerlines, transparent corridor fill,
# gray corridor boundary) under figures/route_with_legs/.
SAVE_ROUTE_FIGURES = True
LEG_FIGURE_DPI = 160

# ----------------------------------------------------------------------
# Roundabouts (fat ring-nodes at high-degree junction areas)
# ----------------------------------------------------------------------
# Before routing settles, junction AREAS where many corridors meet (a TN
# node -- or a tight cluster of them -- carrying >= MIN_DEGREE legs) are
# REPLACED by a roundabout: one "fat" ring-node at the cluster centre with
# an optimally-sized radius. The ring inherits the members' shared cost
# identity; the member nodes + their internal legs are removed, the legs
# rebuild onto the ring and are clipped to its boundary. Outputs
# roundabouts.csv + roundabout_members.csv and draws the rings on
# 00_corridor_network.png. Set ROUNDABOUT_ENABLE=False to disable.
ROUNDABOUT_ENABLE            = True
ROUNDABOUT_MIN_DEGREE        = 5       # min incident legs for a node to seed a ring
ROUNDABOUT_MERGE_RADIUS_M    = 320.0   # cluster/absorb nodes within this radius
ROUNDABOUT_MIN_RADIUS_M      = 120.0   # smallest ring radius
ROUNDABOUT_MAX_RADIUS_M      = 450.0   # largest ring radius
# Per-ring radius CAP, keyed by any member node label (stable across ring
# renumbering). Only ever shrinks a ring. Use to tame an over-large ring that
# crowds nearby corridors -- e.g. RBT01 (MAJ013+MIN001+MIN002) hits the 450 m
# density cap and squeezes the RBT03<->RBT04 corridor, so cap it to 370 m
# (still encircles its members, spread ~= 364 m, and clears the corridor).
ROUNDABOUT_RADIUS_OVERRIDES  = {"MAJ013": 370.0, "MIN005": 145.0}
# Manual lateral shift of a specific leg's corridor, keyed by leg_id. Value is
# the max sideways BOW in metres toward +x (east / right on the map); the leg is
# bowed out in the middle and tapered back to its fixed endpoints, preserving the
# A<->B lane separation, and never bowed into an obstacle. Use to pull a corridor
# off a neighbour it runs too close to, e.g. DB02->MIN016 bundles with
# MIN016->RBT07, so bow it 60 m east into the open space.
LEG_LATERAL_SHIFTS           = {"DB02__MIN016": 60.0}
ROUNDABOUT_MEMBER_MARGIN_M   = 40.0    # ring encircles members + this margin
# Ring size scales with TRAFFIC DENSITY: radius += GAIN * (entering legs), so
# busier junctions get a bigger roundabout.
ROUNDABOUT_DENSITY_GAIN_M    = 18.0    # extra radius per entering leg
ROUNDABOUT_LANE_GAP_M        = 50.0    # gap between outer (red) and inner (blue) ring lane
ROUNDABOUT_OBSTACLE_CLEARANCE_M = 40.0 # keep ring this far from no-fly cells
ROUNDABOUT_RING_GAP_M        = 40.0    # min gap between two rings
# When a ring cannot fit (obstacle / another ring) the CENTRE is nudged away
# (estimated from centre+radius) up to NUDGE_MAX over NUDGE_PASSES before the
# radius is shrunk as a last resort.
ROUNDABOUT_NUDGE_MAX_M       = 200.0   # max centre displacement per fit pass
ROUNDABOUT_NUDGE_PASSES      = 4       # nudge iterations
# Corridor <-> ring buffer separation. remove_legs_through_rings only tests leg
# CENTERLINES, so a corridor that clears a ring it does not connect to can still
# have one of its +/-offset lanes (and that lane's buffer band) dip into the
# ring's buffer. This pass BENDS such legs radially outward around the offending
# ring so the near lane keeps RING_CORRIDOR_SEPARATION_M from the ring's outer
# lane, then rebuilds the two lanes as a tangent (or sideways-shifted) pair of
# the detoured centerline -- lane-to-lane separation and the leg endpoints are
# preserved. Legs whose ENDPOINT node itself sits inside the ring buffer cannot
# be shifted and are reported instead. Writes ring_corridor_separation.csv.
RING_SEPARATION_ENABLE       = True
RING_CORRIDOR_SEPARATION_M   = 50.0    # min gap: near lane centerline -> ring outer lane
RING_DETOUR_SAMPLE_M         = 15.0    # centerline re-sampling step for the bend
RING_DETOUR_MAX_PASSES       = 3       # re-check/shift iterations (multi-ring convergence)
