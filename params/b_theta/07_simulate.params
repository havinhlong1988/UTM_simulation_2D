# ======================================================================
# Multi-agent 2D corridor traffic simulation (09_simulate_agents_2d.py)
# ======================================================================
# A fleet of UAV agents flies missions between the DB (depot) and DK
# (delivery) objectives on the two-lane corridor network from step 07,
# plus continuous city-monitoring PATROLS that loop around the map.
#
# Occupancy rule -- ONE AGENT PER LEG-BLOCK:
#   * each directed leg-lane is a block that holds at most ONE agent at a
#     time ("same leg cannot be captured by two agents"); the reverse
#     lane of a corridor is a separate block (direction can differ);
#   * an origin may launch MANY agents at once, as long as they take
#     different first legs (different paths);
#   * there is NO global concurrency cap, so the observed peak concurrent
#     count is the network's true simultaneous-agent capacity;
#   * demand arrives uniformly over SHIFT_HOURS; excess queues as backlog.
# ----------------------------------------------------------------------

# Input / output ------------------------------------------------------
CORRIDOR_DIR = "output/b_theta/05_corridor_network"
OUTPUT_DIR   = "output/b_theta/07_agent_sim"
# Slowness cost-map from 08_generate_costmap.py (true velocity = slowness x
# base speed). If the file is absent, base speeds are used.
COST_MAP_FILE = "output/b_theta/06_costmap/slowness_costmap.npz"
# Planning-model .xyz grid from step 02 (has obstacle_flag / ra_flag); its
# obstacles + no-fly (RA) cells are overlaid on 00_network_traffic.png. Absent
# -> no overlay.
OBSTACLE_MODEL_FILE = "output/01_random_node_map/random_2d_node_riskmap_seed2298177982.xyz"
# Stage 05's own params, read for ROUNDABOUT_LANE_GAP_M so the ring geometry
# modelled here matches the rings 05 actually built (0 = one single ring).
CORRIDOR_PARAM_FILE = "params/b_theta/05_corridor_network.params"

# Fleet ---------------------------------------------------------------
N_AGENTS        = 1000       # total delivery missions (demand)
SHIFT_HOURS     = 1.0        # nominal target window (deadline search starts here)
ARRIVAL_WINDOW_H = 0.0       # demand injected over this span; 0 -> all ready at t=0
BALANCE_ROUTES  = True       # cycle missions round-robin over ALL routes (use them
                             #   all at once) instead of random endpoints
MAX_CONCURRENT  = 150        # meter airborne agents to this many (lower -> fewer
                             #   simultaneous crossings/conflicts, longer makespan).
LAUNCH_SPACING_S = 2.0       # min seconds between successive delivery launches, so
                             #   departures are spread in time (fewer conflicts).
                             #   IGNORED when SCHEDULE_MODE is on (see below).

# Coordination: STRATEGIC DEPARTURE SCHEDULING --------------------------
# SCHEDULE_MODE assigns every mission a CTOT before the run, instead of metering
# the queue reactively as it drains. The schedule is built so the separation
# standard holds at the one point the operator controls -- the departure time:
#   * successive departures on the SAME first leg-lane are >= SCHEDULE_HEADWAY_S
#     apart (the in-trail standard, so the first corridor is never over-fed);
#   * missions leaving the same origin on DIFFERENT first legs may depart
#     together -- separate corridors are laterally separated already;
#   * the predicted airborne count stays under MAX_CONCURRENT, and no single
#     origin exceeds SCHEDULE_ORIGIN_CAP airborne (0 = the DCB fair share).
# Missions are served FIRST-COME-FIRST-SERVED: processed in arrival order, so
# an earlier mission gets first PICK of a slot. That is not a monotone departure
# order -- a mission bound for a quiet lane and an empty dock clears before one
# queued ahead of it that needs a busy one. figures/04_schedule.png shows this.
# With SCHEDULE_MODE on, LAUNCH_SPACING_S and DCB_MODE are switched off -- the
# plan already meters the same traffic, and running both fights the plan. The
# physical merge check still has the last word at launch.
SCHEDULE_MODE      = True
SCHEDULE_HEADWAY_S = 30.0    # per-departure-corridor slot spacing (= TIME_HEADWAY_S)
SCHEDULE_BIN_S     = 5.0     # resolution of the predicted-occupancy profile
SCHEDULE_ORIGIN_CAP = 0      # airborne cap per origin; 0 = DCB fair share
ROUND_TRIP_PROB = 0.5        # P(non-contingency mission is a round trip)
SIM_SEED        = 12345      # RNG seed for reproducible fleets

# Deadline search: smallest window in which ALL deliveries finish -------
DEADLINE_START_H = 1.0       # target (force all to finish within this)
DEADLINE_STEP_H  = 0.5       # if not, extend the window by this each step

# Drone energy + battery: P(v) = HOVER_POWER_W + DRAG_POWER_COEF * v^3 ---
HOVER_POWER_W   = 220.0      # hover / induced power floor (W); also drain while holding
DRAG_POWER_COEF = 0.050      # parasitic term (W per (m/s)^3); sets optimal speed
BATTERY_WH      = 200.0      # usable battery energy per drone (Wh)
START_BATTERY_PCT = 1.0      # battery charge at first launch
# Dock charging: at each dock the drone recharges; it may only depart again
# once it reaches CHARGE_TARGET_PCT. Charge time = (target - level)/CHARGE_POWER.
CHARGE_POWER_W    = 600.0    # charge rate (W)  -> ~20 min for a full 200 Wh pack
CHARGE_TARGET_PCT = 1.0      # must be FULLY charged before leaving a dock

# UAV speed classes ---------------------------------------------------
SPEED_CLASSES_KMH   = [60.0, 50.0, 30.0]   # 3 UAV classes
SPEED_CLASS_WEIGHTS = [1.0, 1.0, 1.0]      # selection weights (normalised)

# Route-aware priority ------------------------------------------------
# Missions whose ORIGIN or DEST is one of these objective labels are
# prioritised: exempted from the inner/outer ZONE_BIAS_M steering (they take
# the DIRECT spine), given launch/merge precedence, and (if PRIORITY_FORCE_SPEED)
# forced to PRIORITY_SPEED_KMH. The DB01 hub is the network's congestion
# bottleneck (its egress legs DB01-MIN005 / DB01-MIN003 carry ~72% of all
# holding delay and ~90% of battery deaths).
#
# EMPIRICAL FINDING (seed 12345, 1000 agents) -- prioritising DB01 traffic does
# NOT improve on-time throughput and in fact HURTS it:
#     config              done  batt_dead  @1h%  @3h%  @5h%  end_h
#     baseline (OFF)      902   98         17.9  59.7  87.6  6.3
#     DB01 force 60km/h   916   84          8.6  38.9  82.0  9.5
#     DB01 access+precede 860  140          7.2  38.5  83.4  5.9
# Cause: separation is a TIME headway, so a leg's throughput = 1/headway is
# INDEPENDENT of speed; "travel faster" cannot add bottleneck capacity, and
# forcing priority traffic fast only lowers lane density (more spacing) while
# front-loading the launch queue with bottleneck-bound agents starves the
# spare-capacity outer routes.
# The one upside of force-60: fewer battery deaths (98->84) and less energy
# (90.9->80.5 kWh), because faster transit cuts hover-time during holds.
#
# NOTE: adding a 3rd DB01 egress corridor was TESTED and also did NOT help
# (DB01->MAJ007 890/206-dead; DB01->MAJ012 890/110-dead vs baseline 902/98).
# DB01 sits in the high-risk map core -- every southbound corridor has mean
# slowness 0.2-0.5, so any added leg is inherently slow to fly, and the step-09
# router plans on GEOMETRIC LENGTH (risk-blind) so it over-uses the short-but-
# risky new leg. The binding limit is the launch backlog (peak 999, ~103 min
# wait): 1000 missions at t=0 vs ~150 concurrent low-risk-airspace capacity.
# Effective fixes = RISK-AWARE routing (cost=length/slowness; cf. step 11 FMM
# planner) + DEMAND SMOOTHING (ARRIVAL_WINDOW_H>0), NOT more corridors.
#
# Left OFF by default (empty list) so the canonical pipeline is not degraded.
PRIORITY_ORIGIN_LABELS = []                # e.g. ["DB01"] to prioritise DB01 traffic
PRIORITY_FORCE_SPEED   = True              # force priority missions to PRIORITY_SPEED_KMH
PRIORITY_SPEED_KMH     = 60.0              # speed class forced on priority missions

# City-monitoring patrols ---------------------------------------------
# One patrol sortie takes off every PATROL_INTERVAL_MIN minutes and flies
# PATROL_LAPS loop(s) of the map perimeter, then lands.
# A SINGLE patrol unit departs the drone base, flies one perimeter loop, lands,
# and re-launches every PATROL_INTERVAL_MIN (one physical drone -- never two
# airborne at once). It holds the highest priority and, with PATROL_AS_OBSTACLE,
# is treated by deliveries as a moving obstacle they keep clear of / behind.
PATROL_INTERVAL_MIN = 30.0   # the patrol unit re-launches every 30 minutes
PATROL_LAPS         = 1      # perimeter loops per sortie
PATROL_SPEED_KMH    = 50.0   # patrol cruise speed
PATROL_AS_OBSTACLE  = True   # deliveries yield to / space behind the patrol

# Roundabout circulation ----------------------------------------------
# RING_TRAVEL: a route passing THROUGH a roundabout node gets a ring ARC spliced
# in, so the agent circulates the ring instead of flying straight across its
# centre. Off, routes cut the corner through the ring interior -- which is not a
# lane (stage 06 raises its cost for exactly that reason), so this must be ON for
# centreline compliance. metrics.json counts any position inside a ring interior.
RING_TRAVEL         = True
# RIGHT-HAND TRAFFIC on the rings: every agent circulates COUNTER-CLOCKWISE, so
# nobody ever takes a clockwise short-cut the wrong way. Because CCW keeps the
# island on the left, every exit leaves to the RIGHT of the direction of travel
# -- checked on this network: all 106 ring-incident legs exit right, none left.
RING_RIGHT_HAND     = True
# With ROUNDABOUT_LANE_GAP_M = 0 stage 05 builds ONE ring, so both travel
# directions share the same physical circle and must share one traffic resource;
# RING_WRAP_FOLLOW makes the in-trail headway hold across the 2*pi*r seam, which
# is what makes the 30 s standard real on a ring rather than nominal.
RING_WRAP_FOLLOW    = True

# ORCA inside the roundabouts -----------------------------------------
# A 40 m ring has a 251 m circumference: at the 50 m separation standard that
# holds FIVE agents, and the first 1000-drone run peaked at NINE on the busiest
# ring. No coordination rule can fix a 1.8x oversubscription -- only geometry
# can, so stage 05 now sizes rings from predicted density (77-126 m here). ORCA
# is what USES that area: inside a zone an agent picks a free 2-D velocity by
# reciprocal collision avoidance (each pair splits the avoidance half and half)
# instead of queueing on a 1-D arc. Its preferred velocity is the roundabout
# rule -- circulate CCW at cruise until its exit bearing comes up, then peel off
# right -- and the solver returns the closest velocity that keeps every pair
# >= 2*ORCA_RADIUS_M apart and everyone between the island and the outer edge.
# Implemented in src/orca.py (numpy only; no Cython build, no AGPL dependency).
ORCA_RINGS          = True
ORCA_RADIUS_M       = 25.0   # half the horizontal standard -> 50 m pair clearance
ORCA_TAU_S          = 4.0    # look-ahead; sized to the zone, not the open map
ORCA_ZONE_MARGIN_M  = 25.0   # ring buffer half-width; zone edge = radius + this
ORCA_ISLAND_FRAC    = 0.35   # centre kept clear (fraction of radius), so agents
                             #   still circulate instead of cutting straight over
# ORCA is exactly symmetric, so head-on / antipodal pairs deadlock at the
# separation distance forever. Measured on the standard benchmarks: head-on pair
# unresolved after 1500 steps at 0 deg, resolved in 72 at 3 deg, with separation
# held either way. A RIGHT bias also matches right-hand traffic convention.
ORCA_BIAS_DEG       = 3.0
ORCA_EXIT_ANGLE_DEG = 25.0   # start lining up on the exit inside this much sweep
ORCA_EXIT_TOL_M     = 30.0   # counted as "at the exit" within this distance

# Contingencies -------------------------------------------------------
# A fraction of trips hit a "false condition" mid-outbound and must
# either REROUTE via a backup corridor to the destination, or RETURN TO
# BASE (fly back to the origin). Split controlled by BACKUP_FRACTION.
CONTINGENCY_PROB = 0.15      # 15% of trips hit a "false condition"
BACKUP_FRACTION  = 0.667     # of the 15%: ~10% reroute to dest (no return),
                             #   ~5% return to base (0.667*15=10, 0.333*15=5)

# Endpoints -----------------------------------------------------------
DB_PREFIX = "DB"
DK_PREFIX = "DK"

# Flight dynamics -----------------------------------------------------
SERVICE_TIME_S = 60.0         # dwell at the far end before a round-trip return
# After arriving at the destination (round trips), the agent PARKS at the dock
# for at least this long -- long enough to charge to CHARGE_TARGET_PCT and
# reload -- before flying the return leg. A parked drone sits on the pad: it is
# not airborne traffic, draws no hover power, and is EXEMPT from the separation
# and conflict checks (it is outside the airborne set by construction, and
# metrics.json reports how many agent-samples that exemption covered).
MIN_DEST_IDLE_S = 1800.0      # 30 minutes parked at the dock (charging)
# Physical dock capacity. A pad is occupied for DOCK_PARK_BUFFER_S (manoeuvring
# onto and off the pad) plus MIN_DEST_IDLE_S (charging) = 40 min per visit.
# The DEPARTURE scheduler books a pad before clearing a mission to launch: it
# predicts the arrival time with eta_seconds(), which prices the route through
# the cost-map (true velocity = slowness * cruise) instead of assuming cruise
# speed, and if the dock would be full on arrival the departure is PUSHED BACK.
# Holding a drone on the ground is strictly better than sending it to hover
# over a full dock burning battery. The capacity is enforced at run time too,
# as a safety net: metrics.json reports peak use per dock and how many
# arrivals ever had to wait, which should stay near zero if the plan holds.
DOCK_CAPACITY      = 5        # drones that can be parked at one dock at once
DOCK_PARK_BUFFER_S = 600.0    # 10 min of pad time on top of the charging stop
# LIVE pad reservations. The CTOT scheduler books a pad once, before launch,
# from a predicted arrival -- and over a long schedule that prediction drifts
# (holds, cost-map slow-downs, ORCA detours). Once the pads run at 100% any
# drift becomes a booking conflict. So the reservation is RE-PLANNED in flight:
# every RESERVATION_UPDATE_S the remaining route is re-priced through the
# cost-map and, if the arrival has moved by more than the tolerance, the pad is
# re-booked. A drone may only land on a pad it holds a STARTED reservation for,
# so capacity is guaranteed by the booking instead of checked on arrival, and a
# drone that has lost its slot learns en route rather than over a full dock.
RESERVATION_UPDATE_S    = 60.0    # how often a drone re-prices its arrival
RESERVATION_TOLERANCE_S = 120.0   # drift this large triggers a re-booking
# If the earliest free pad is more than this beyond a drone's predicted arrival,
# it is not launched at all -- holding it on the ground beats sending it up to
# hover over a dock that will still be full when it gets there.
PAD_LAUNCH_SLIP_S       = 300.0

# Deconfliction -------------------------------------------------------
# FLOW_MODE controls lane occupancy:
#   "spacing" -- many agents per lane, each kept >= SEPARATION_M behind the
#                one ahead (car-following). Deadlock-free: the fleet always
#                drains, so completion-time / energy studies are meaningful.
#   "block"   -- strict ONE agent per leg-lane. Matches "same leg cannot be
#                captured by two agents", but gridlocks under heavy load
#                (circular waits at junctions), so most missions never finish.
FLOW_MODE      = "spacing"
# Separation is a TIME headway: an agent stays >= TIME_HEADWAY_S seconds behind
# the one ahead, so the distance gap scales with speed (30 s = 500 m at 60 km/h,
# 250 m at 30 km/h). SEPARATION_M is only a lower-bound floor.
# SEPARATION STANDARD -- two halves, measured separately:
#   LONGITUDINAL (in trail, SAME corridor): TIME_HEADWAY_S seconds. A follower
#     never closes inside this, so the distance gap scales with speed
#     (30 s = 250 m at 30 km/h, 500 m at 60 km/h).
#   HORIZONTAL (lateral, ANY corridor, same flight level): SEPARATION_M metres.
#     This is also the floor under the time headway, and it matches the corridor
#     network's own build rule -- 05 keeps the two lane centrelines of every leg
#     >= 50 m apart (centerline_min_separation_m), so a compliant pair passes on
#     its own geometry. metrics.json reports every same-level pair-sample that
#     comes closer, with no same-leg exemption.
TIME_HEADWAY_S = 30.0         # longitudinal (in-trail) minimum
SEPARATION_M   = 50.0         # horizontal (lateral) minimum
# A CONFLICT (marked with a red star) is a near-miss between agents on
# DIFFERENT corridors: they come within CONFLICT_TIME_S seconds of impact
# (distance below CONFLICT_TIME_S * the faster agent's speed). 5 s ~= 80 m
# at cruise, matching the "80 m ~ 5.6 s to impact" reference.
CONFLICT_TIME_S = 5.0
# MERGE rule: a new agent may merge onto a lane only if the nearest agent
# already on it is at least this fraction of the leg length ahead (that much
# of the leg free), never closer than SEPARATION_M. The lane is "locked" to
# new entries until its occupant clears that much of it; if no lane is free
# the agent waits. Spreads traffic across more lanes/routes.
MERGE_FREE_FRAC = 0.5

# Dynamic ACO-style routing ------------------------------------------
# Routes are planned at launch by least-cost search over the network,
# with a congestion "pheromone": capturing a leg adds CAPTURE_COST_M to
# its routing cost; that penalty decays to 0 as the occupant passes the
# half-way point of the leg. So the next agent routes AROUND captured
# legs (onto longer paths). ZONE_BIAS_M steers the fastest class to the
# OUTER corridors and the slowest to the shorter INNER ones.
CAPTURE_COST_M = 3000.0       # cost a freshly-captured leg adds (metres-equiv)
ZONE_BIAS_M    = 2000.0       # inner/outer steering strength by speed class
# HIGH penalty added to a leg while an occupant is HOLDING/WAITING on it, so the
# router sends following agents around the jam instead of queueing behind it.
HOLD_PENALTY_M = 20000.0
# Flight-level (altitude) separation --------------------------------
# Each leg gets a level from its travel HEADING (semicircular-rule style), so
# crossing / opposing traffic is vertically separated. Two agents only CONFLICT
# when horizontally close AND on the SAME level; the node mutex likewise only
# serialises same-level agents. FLIGHT_LEVELS bands = 360/FLIGHT_LEVELS deg each.
FLIGHT_LEVELS = 6             # number of altitude bands (>=2 splits opposing dirs;
                              #   6 ~halves conflicts vs 4 at no throughput cost)
LEVEL_SEP_M   = 30.0          # vertical spacing between bands (for reporting/3D)
BASE_LEVEL_M  = 60.0          # altitude of the lowest band (m)

# Junction (node) mutex, keyed by (node, LEVEL): forbids two SAME-LEVEL agents
# inside a junction zone at once. WARNING: at these zone sizes it GRIDLOCKS this
# network under 1000-agent load (circular waits at hubs -> only ~1% finish), so
# it is left OFF -- flight levels + metering already cut conflicts ~78% without
# any throughput loss. Enable only with much smaller zones / lighter load.
NODE_MUTEX_ENABLE = False
NODE_APPROACH_M      = 20.0   # node-mutex zone at traffic nodes (if enabled)
OBJECTIVE_APPROACH_M = 50.0   # node-mutex zone at DB/DK hubs (if enabled)

# Time stepping -------------------------------------------------------
DT_S              = 1.0       # simulation step
HORIZON_FACTOR    = 80.0      # cap sim time at SHIFT * factor; large so the run fully
                              #   drains all missions (ends early when all complete)
GRIDLOCK_TIMEOUT_S = 300.0    # if nothing moves this long -> declare gridlock & stop
STUCK_TIMEOUT_S    = 180.0    # if an agent is blocked this long at a node, it diverts
                              #   via an alternate corridor (breaks spillback deadlocks)

# Outputs -------------------------------------------------------------
SAMPLE_EVERY_S   = 20.0       # record a timeline/animation frame this often (finer
                              #   sampling + HTML lerp between frames -> smoother motion)
MAX_GIF_FRAMES   = 360        # subsample frames down to at most this many
GIF_FPS          = 20
MAKE_HTML        = True        # self-contained interactive 2D agents_animation.html
# Per-agent route replays under output/08_agent_sim_2d/agent_route/ (one HTML per
# agent + index.html) to inspect each agent's travel. MAX = -1 -> all agents.
MAKE_AGENT_ROUTE_HTML     = True
AGENT_ROUTE_MAX           = -1
AGENT_ROUTE_INCLUDE_PATROL = False
MAKE_ANIMATION   = True        # matplotlib agents_animation.gif
WRITE_TRAJECTORY = True        # downsampled trajectories.csv

# PyVista 3D view -----------------------------------------------------
MAKE_PYVISTA      = True       # 3D scene: movie + interactive HTML + PNG
PYVISTA_MAX_FRAMES = 300       # subsample frames for the 3D movie
PYVISTA_Z_OUTBOUND = 60.0      # altitude (m) of outbound (to-DK) agents
PYVISTA_Z_INBOUND  = 100.0     # altitude (m) of inbound (to-DB) agents
PYVISTA_Z_PATROL   = 140.0     # altitude (m) of patrol agents
